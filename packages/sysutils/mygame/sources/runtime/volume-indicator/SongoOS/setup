#!/bin/bash

ORIGINAL="/usr/bin/volume"
BACKUP="/tmp/songo-volume-original.sh"
WRAPPER="/tmp/songo-volume-wrapper.sh"

cp "$ORIGINAL" "$BACKUP"

cat > "$WRAPPER" << 'EOF'
#!/bin/bash
"$ORIGINAL" "$@"
. /etc/profile.d/001-functions
VOL=$(get_setting "audio.volume")
echo "$VOL" | nc -w 1 127.0.0.1 23456
EOF

chmod +x "$WRAPPER"

if ! mountpoint -q "$ORIGINAL"; then
    mount --bind "$WRAPPER" "$ORIGINAL"
fi
