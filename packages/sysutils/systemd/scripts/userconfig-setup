STAMP=/storage/.config/.userconfig-version
USR_CONFIG_VER=$(find /usr/config -newer /usr/config -maxdepth 0 -printf '%T@' 2>/dev/null || stat -c '%Y' /usr/config 2>/dev/null)

# Skip the full scan if config hasn't changed since last run
if [ -f "${STAMP}" ] && [ "$(cat ${STAMP} 2>/dev/null)" = "${USR_CONFIG_VER}" ]; then
  exit 0
fi

# Remove those sample files that we manage
find /storage/.config -maxdepth 3 -name '*.sample' 2>/dev/null | while read sample; do
  [ -f /usr/config/${sample:17} ] && rm -f "${sample}"
done

# Copy config files, but don't overwrite - this should replace our sample files
false | cp -iRp /usr/config/* /storage/.config/ &>/dev/null

echo "${USR_CONFIG_VER}" > "${STAMP}"
