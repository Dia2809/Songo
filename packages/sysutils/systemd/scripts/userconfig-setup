. /etc/os-release

STAMP="/storage/.cache/userconfig-${BUILD_ID:-0}"

# Skip if this build's config was already applied
[ -f "${STAMP}" ] && exit 0

# Remove those sample files that we manage
find /storage/.config -maxdepth 3 -name '*.sample' 2>/dev/null | while read sample; do
  [ -f /usr/config/${sample:17} ] && rm -f "${sample}"
done

# Copy config files, but don't overwrite - this should replace our sample files
false | cp -iRp /usr/config/* /storage/.config/ &>/dev/null

mkdir -p /storage/.cache
touch "${STAMP}"
